# Variables d'environnement — Portfolio + Admin Panel
# Copier dans .env.local (déjà gitignoré via *.local)

# ── ADMIN (préfixe VITE_ = visible côté client, OK car lecture seule admin) ──
VITE_GITHUB_USERNAME=ton-username
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── SERVEUR UNIQUEMENT (pas de préfixe VITE_ → jamais dans le bundle client) ──
# Token GitHub pour le proxy /api/github — scope minimum recommandé :
#   - public_repo (si seulement repos publics)
#   - repo (si repos privés nécessaires pour l'admin sync)
# À configurer dans Vercel Dashboard → Settings → Environment Variables
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
